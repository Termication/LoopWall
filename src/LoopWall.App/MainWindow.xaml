<Window x:Class="LoopWall.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoopWall" Height="790" Width="1240"
        MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="#F4F7FC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="12" Background="#3478F6" VerticalAlignment="Center">
                    <TextBlock Text="▶" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="White"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LoopWall" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Your desktop, in motion." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="#1C302A" CornerRadius="20" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#55D69A" Margin="0,0,8,0"/>
                    <TextBlock Text="Preview mode" Foreground="#A8E7C8" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Preview panel -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Wallpaper preview" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="Preview a video before making it your wallpaper."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PreviewStateText" Text="NO VIDEO" Foreground="#9AA7BA"
                                   FontSize="10" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#080B10" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="VideoPreview"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          MediaOpened="VideoPreview_MediaOpened"
                                          MediaEnded="VideoPreview_MediaEnded"
                                          MediaFailed="VideoPreview_MediaFailed"/>
                            <StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="▶" FontSize="42" Foreground="#52627A"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Your video preview appears here" FontSize="14"
                                           Foreground="#AAB6C8" Margin="0,12,0,0"/>
                                <TextBlock Text="Import a video to get started" FontSize="11"
                                           Foreground="#68768A" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedVideoName" Text="No video selected"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SelectedVideoDetails" Text="Choose a video from your library"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click"
                                    IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="Stop" Click="StopButton_Click" IsEnabled="False" x:Name="StopButton"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="Phase 1 preview only — applying a live desktop wallpaper arrives in a later phase."
                               Foreground="#E7BC72" FontSize="11" Margin="0,15,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- Library -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Video library" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LibraryCountText" Text="0 videos"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Row="1" Content="+  Import videos" Background="{StaticResource AccentBrush}"
                            Click="ImportVideosButton_Click" Margin="0,16,0,14"/>
                    <ListBox x:Name="VideoList" Grid.Row="2" Background="Transparent"
                             BorderThickness="0" Foreground="#F4F7FC"
                             SelectionChanged="VideoList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Background" Value="#202938"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#263F68"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Extension}" Foreground="#91A0B5"
                                               FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="Supported extensions: MP4, WMV, AVI, MOV, MKV, WebM"
                               Foreground="{StaticResource MutedBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="LOOPWALL  •  PHASE 1" Foreground="#65748A" FontSize="10"
                       FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
